# PostHog analytics (optional). Without these variables the app runs with analytics off.
# For local development copy this file to .env.development (dev server only, gitignored).
# Do not use .env: Vite also loads it for production builds and tests, and the browser
# journeys in ./scripts/verify expect a build without external requests.
# The published GitHub Pages build reads the same names from repository Actions variables.
VITE_PUBLIC_POSTHOG_HOST="https://eu.i.posthog.com"
VITE_PUBLIC_POSTHOG_PROJECT_TOKEN="phc_your_project_token"
